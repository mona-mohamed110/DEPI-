EMAIL_PASS=

# بديل Gmail: SMTP عام (مثلاً Brevo - مجاني 300 رسالة يومياً). إذا ضُبط هذا يُستخدم بدل EMAIL_USER/EMAIL_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# (اختياري) مساعد فرز الأعراض بنموذج Claude. بدونه يعمل المساعد بمحرك القواعد المدمج.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
