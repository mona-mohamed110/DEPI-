# انسخ الملف ده باسم .env وعدّل القيم
# رابط الـ Backend الحقيقي. لو سبته فاضي المشروع يشتغل على البيانات الوهمية (src/mock)
VITE_API_URL=
# VITE_API_URL=https://api.example.com/api/v1

# true = استخدام البيانات الوهمية حتى لو VITE_API_URL متحدد (للتجربة)
VITE_USE_MOCK=false

# same-origin | include  (include لو الـ API على دومين تاني وبيستخدم httpOnly cookies)
VITE_API_CREDENTIALS=same-origin

# مهلة الطلب بالمللي ثانية
VITE_API_TIMEOUT=15000

# true = الطبيب والمعمل لازم الأدمن يعتمد الترخيص قبل ما يدخلوا
VITE_REQUIRE_LICENSE_APPROVAL=false
